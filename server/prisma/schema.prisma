generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  FOCUS
  DONE
  ARCHIVED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  archiveAfterDays Int      @default(7)
  focusLimit       Int      @default(3)
  deleteArchivedAfterDays Int @default(30)
  showArchiveTab   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tasks            Task[]
}

model Task {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, priority])
}
