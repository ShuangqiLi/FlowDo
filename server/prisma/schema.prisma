generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  FOCUS
  DONE
  ARCHIVED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
  NONE
  REMINDER
}

enum RemindRepeat {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CRON
}

/// 一台部署只有一行：登录密码、语音开关和当前空间。
model Instance {
  id                 String   @id
  passwordHash       String
  /// 还没设过密码时为 true，设好之后清掉。
  mustChangePassword Boolean  @default(false)
  activeSpaceId      String?
  activeSpace        Space?   @relation("ActiveSpace", fields: [activeSpaceId], references: [id], onDelete: SetNull)
  voiceInputEnabled  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// 任务空间：主题、聚焦上限和归档习惯各自独立。
model Space {
  id                      String     @id @default(uuid())
  name                    String
  archiveAfterDays        Int        @default(7)
  focusLimit              Int        @default(3)
  deleteArchivedAfterDays Int        @default(30)
  showArchiveTab          Boolean    @default(false)
  /// 关掉后，循环提醒仍会到点，只是不出现在任务池。
  showRecurringReminders  Boolean    @default(true)
  themeKey                String     @default("mint")
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  tasks                   Task[]
  notices                 Notice[]
  activeFor               Instance[] @relation("ActiveSpace")
}

model Task {
  id          String       @id @default(uuid())
  spaceId     String
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  title       String
  body        String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(NONE)
  /// 优先级是提醒时，到这一分钟就送进聚焦。循环则到点复制一份。
  remindAt    DateTime?
  remindRepeat RemindRepeat @default(ONCE)
  /// remindRepeat 为 CRON 时用的五段 crontab（分 时 日 月 周）。
  remindCron  String?
  /// 按农历走月/年循环；仅一次时只用来展示。
  remindLunar Boolean      @default(false)
  /// 单次提醒响过之后设上，避免反复送进聚焦。
  remindedAt  DateTime?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  notices     Notice[]

  @@index([spaceId, status])
  @@index([spaceId, priority])
  @@index([priority, remindAt])
}

/// 提醒到点后留在右上角通知里，直到看过。
model Notice {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([spaceId, readAt])
}
